# frozen_string_literal: true

module PgRls
  module ActiveRecord
    module ConnectionAdapters
      module RlsTenant
        UNKNOWN: :unknown

        @raw_connection: PG::Connection?

        # nil: no tenant; UNKNOWN: a rollback may have put the session on any tenant, or none.
        attr_accessor rls_tenant_id: String | :unknown | nil

        def exec_rollback_db_transaction: () -> untyped

        def exec_restart_db_transaction: () -> untyped

        def exec_rollback_to_savepoint: (?String? name) -> untyped

        def commit_db_transaction: () -> untyped

        private def configure_connection: () -> void

        private def forget_rls_tenant: () -> :unknown

        private def rls_transaction_aborted?: () -> bool
      end

      module ConnectionPool
        attr_reader checkout_timeout: untyped

        def checkout: (?untyped checkout_timeout) -> untyped

        def rls_connection?: () -> bool

        def pool_config: () -> untyped

        private def reset_rls_used_connections: (ActiveRecord::ConnectionAdapters::PostgreSQLAdapter conn) -> nil

      end
    end
  end

  class Tenant
    def self.reset_rls_used_connections: (ActiveRecord::ConnectionAdapters::PostgreSQLAdapter conn) -> nil

    def set_rls: (ActiveRecord::ConnectionAdapters::PostgreSQLAdapter conn) -> Tenant

  end

  module Current
    def self.tenant: () -> Tenant
  end
end

module ActiveRecord
  module ConnectionAdapters
    class ConnectionPool
      attr_reader checkout_timeout: untyped
    end
  end
end


